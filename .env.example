# ---- LLM provider (provider-agnostic; all use the OpenAI-compatible API) ----
# Choose one provider and set its key. Defaults to Hugging Face's free router.

LLM_PROVIDER=huggingface
# HF router (free tier). Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.1
# AGENT_MAX_ITERATIONS=8

# ---- To switch providers, change LLM_PROVIDER and supply that key ----
# OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Groq (free):
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# Gemini (free tier):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-2.0-flash

# ---- Data ----
# Optional: point at a specific workbook file (defaults to the bundled one).
# PARCELPILOT_WORKBOOK=/app/app/data/ParcelPilot_Assessment_Data.xlsx
